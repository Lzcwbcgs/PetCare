{
  "openapi": "3.0.0",
  "info": {
    "title": "PetCare API - 宠物医疗协同管理平台",
    "description": "基于 GoFrame v2 的宠物医疗协同管理平台后端 API 文档。\n\n## 认证方式\n所有需要认证的接口需要在 HTTP Header 中提供 Bearer Token：\n```\nAuthorization: Bearer <JWT_TOKEN>\n```\n\n## 响应格式\n所有 API 响应都遵循统一的格式：\n```json\n{\n  \"code\": 0,\n  \"message\": \"success\",\n  \"data\": {}\n}\n```\n- code: 错误码，0 表示成功\n- message: 提示信息\n- data: 实际数据，成功时返回具体数据，失败时为 null",
    "version": "1.0.0",
    "contact": {
      "name": "PetCare Team",
      "url": "https://github.com/pet-care"
    },
    "license": {
      "name": "Apache 2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "本地开发服务器"
    },
    {
      "url": "https://api.petcare.com",
      "description": "生产环境服务器"
    }
  ],
  "tags": [
    {
      "name": "认证模块",
      "description": "用户、医生、管理员的注册、登录、登出等认证相关接口"
    },
    {
      "name": "用户资料",
      "description": "普通用户的个人资料查询、编辑和密码修改接口"
    },
    {
      "name": "医生资料",
      "description": "医生的个人资料查询、编辑和密码修改接口"
    },
    {
      "name": "管理员资料",
      "description": "管理员的个人资料查询接口"
    },
    {
      "name": "宠物管理",
      "description": "宠物档案的创建、查询、编辑和删除接口"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "x-apifox-folder": "认证模块",
        "tags": ["认证模块"],
        "summary": "用户注册",
        "description": "新用户注册账户，注册成功后返回新用户ID",
        "operationId": "authRegister",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "nickname", "phone"],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 32,
                    "description": "登录用户名，长度3-32个字符",
                    "example": "john_doe"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 64,
                    "description": "登录密码，长度6-64个字符",
                    "example": "password123"
                  },
                  "nickname": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "description": "用户昵称，长度1-32个字符",
                    "example": "John Doe"
                  },
                  "phone": {
                    "type": "string",
                    "description": "手机号码，需要符合手机号格式",
                    "example": "13800000000"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "邮箱地址（可选）",
                    "example": "john@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user_id": {
                          "type": "integer",
                          "description": "新注册用户ID",
                          "example": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "x-apifox-folder": "认证模块",
        "tags": ["认证模块"],
        "summary": "统一登录",
        "description": "用户、医生、管理员使用用户名和密码登录，需要指定登录角色",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "role"],
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "登录用户名",
                    "example": "john_doe"
                  },
                  "password": {
                    "type": "string",
                    "description": "登录密码",
                    "example": "password123"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["user", "doctor", "admin"],
                    "description": "登录角色，必须是 user、doctor 或 admin 之一",
                    "example": "user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "JWT 访问令牌",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "expire_at": {
                          "type": "string",
                          "format": "date-time",
                          "description": "令牌过期时间",
                          "example": "2024-03-29T14:30:00Z"
                        },
                        "user_id": {
                          "type": "integer",
                          "description": "当前登录用户ID",
                          "example": 1
                        },
                        "role": {
                          "type": "string",
                          "description": "当前登录角色",
                          "example": "user"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "x-apifox-folder": "认证模块",
        "tags": ["认证模块"],
        "summary": "获取当前登录信息",
        "description": "获取当前登录用户的基本信息，需要有效的 Authorization Token",
        "operationId": "authMe",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "username": {
                          "type": "string",
                          "example": "john_doe"
                        },
                        "role": {
                          "type": "string",
                          "example": "user"
                        },
                        "nickname": {
                          "type": "string",
                          "example": "John Doe"
                        },
                        "avatar_url": {
                          "type": "string",
                          "example": "https://example.com/avatar.jpg"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "x-apifox-folder": "认证模块",
        "tags": ["认证模块"],
        "summary": "退出登录",
        "description": "退出登录，注销当前 Token，使其立即失效",
        "operationId": "authLogout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "退出成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
