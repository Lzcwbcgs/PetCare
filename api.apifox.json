    "/api/pets": {
      "post": {
        "x-apifox-folder": "宠物管理",
        "tags": ["宠物管理"],
        "summary": "新增宠物档案",
        "description": "为当前登录用户创建一个新的宠物档案",
        "operationId": "petCreate",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pet_name"],
                "properties": {
                  "pet_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "宠物名称",
                    "example": "Fluffy"
                  },
                  "pet_type": {
                    "type": "string",
                    "description": "宠物类型",
                    "example": "cat"
                  },
                  "avatar_url": {
                    "type": "string",
                    "description": "头像地址",
                    "example": "https://example.com/pet.jpg"
                  },
                  "gender": {
                    "type": "integer",
                    "enum": [0, 1, 2],
                    "description": "性别（1公，2母，0未知）",
                    "example": 1
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "年龄",
                    "example": 3
                  },
                  "age_unit": {
                    "type": "string",
                    "enum": ["month", "year"],
                    "description": "年龄单位（month/月，year/岁）",
                    "example": "year"
                  },
                  "breed": {
                    "type": "string",
                    "description": "品种",
                    "example": "波斯猫"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "description": "体重（kg）",
                    "example": 4.5
                  },
                  "sterilized": {
                    "type": "integer",
                    "enum": [0, 1],
                    "description": "是否绝育（1是，0否）",
                    "example": 1
                  },
                  "remark": {
                    "type": "string",
                    "description": "备注",
                    "example": "性格温和"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "pet_id": {
                          "type": "integer",
                          "example": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "x-apifox-folder": "宠物管理",
        "tags": ["宠物管理"],
